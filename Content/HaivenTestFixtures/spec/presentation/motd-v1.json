{
  "schema_version": 1,
  "id": "haiven.presentation.motd/v1",
  "capability": "motd-display",
  "fixture_set": "motd-display-v1",
  "projection": {
    "closed": true,
    "required_fields": [
      "revision",
      "status",
      "visible",
      "message",
      "error",
      "dismissedId"
    ],
    "status_values": [
      "loading",
      "absent",
      "present",
      "failure"
    ],
    "message": {
      "required_fields": [
        "id",
        "title",
        "body"
      ],
      "optional_fields": [
        "url"
      ]
    }
  },
  "policy": {
    "fallback_title": "Message of the day",
    "text_format": "plain-text",
    "failure_copy": "Unable to load message of the day.",
    "action": {
      "optional": true,
      "allowed_scheme": "https",
      "userinfo_allowed": false,
      "navigation_owner": "host"
    },
    "boundary": {
      "direction": "sdk-to-host-presentation",
      "allow_fields": [
        "revision",
        "status",
        "visible",
        "message",
        "error",
        "dismissedId"
      ],
      "forbid_categories": [
        "credentials",
        "authorization",
        "cookies",
        "tokens",
        "integration-configuration",
        "transport-configuration"
      ]
    }
  },
  "transition_rules": {
    "revision": "Increment once for each accepted state transition; duplicates, suppressed ids, and stale completions are no-ops.",
    "duplicate": "A message id already presented at the current revision is not presented again.",
    "dismissal": "Dismissal hides the current message and suppresses later delivery of the same id.",
    "new_id": "A different message id is eligible for presentation after dismissal.",
    "source_order": "Realtime state accepted after a REST load starts supersedes that older REST completion.",
    "clear": "A clear transition removes the current message while retaining the last dismissed id."
  },
